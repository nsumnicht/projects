# Copy this file to .env and fill in the real values.
# .env is gitignored, never commit it.

ANTHROPIC_API_KEY=sk-ant-your-key-here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/your-token-here

# Free key from https://api.congress.gov/sign-up/. Leave it out and the
# legislation step skips itself, the rest of the digest still posts.
CONGRESS_API_KEY=your-congress-key-here

# Optional. Set these only for local runs where you want the weekly snapshot
# archived to Postgres. Leave them out and the database step skips itself.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projects_db
DB_USER=projects_user
DB_PASSWORD=password
